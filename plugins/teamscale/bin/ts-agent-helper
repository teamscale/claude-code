#!/usr/bin/env bash
set -euo pipefail

# This launcher stays thin: it locates an interpreter, sets PYTHONPATH and hands
# off to the Python package. Every line of logic here has to exist twice, once
# in Bash and once in the `.cmd` sibling, and the two dialects differ enough
# that the copies drift apart. Put new logic in `scripts/ts_agent_helper/`
# instead; see ../../../CLAUDE.md for the convention.

# Resolve the real location of this script, following symlinks.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/../scripts"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "Error: neither 'python3' nor 'python' found in PATH" >&2
    exit 1
fi

# The minimum Python version is enforced inside the package, in
# `scripts/ts_agent_helper/__init__.py`, so the rule lives in one place
# instead of once per platform launcher.
# Run as a package so its modules can use relative imports.
PYTHONPATH="$SCRIPTS_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m ts_agent_helper "$@"
